    {
        "id": "3ac25b3bf3b20b34",
        "type": "function",
        "z": "0954e87b03b4c32b",
        "name": "Unir Dados",
        "func": "let data = flow.get(\"dados\") || {};\n\ndata = {\n    temperatura: data.temperatura,\n    umidade: data.umidade,\n    distancia: data.distancia\n};\n\nif (msg.topic === \"maquina1/temperatura\") {\n    data.temperatura = Number(msg.payload);\n}\n\nif (msg.topic === \"maquina1/umidade\") {\n    data.umidade = Number(msg.payload);\n}\n\nif (msg.topic === \"maquina1/distancia\") {\n    data.distancia = Number(msg.payload);\n}\n\nflow.set(\"dados\", data);\n\nmsg.payload = data;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 240,
        "wires": [

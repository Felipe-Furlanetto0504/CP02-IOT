    {
        "id": "bf2dafa70c7c65f3",
        "type": "function",
        "z": "0954e87b03b4c32b",
        "name": "Validação",
        "func": "let p = msg.payload;\n\nif (typeof p === \"string\") {\n    try {\n        p = JSON.parse(p);\n    } catch (e) {\n        return null;\n    }\n}\n\nif (!p) return null;\n\nlet temperatura = Number(p.temperatura);\nlet umidade = Number(p.umidade);\nlet distancia = Number(p.distancia);\n\nif (\n    !isFinite(temperatura) ||\n    !isFinite(umidade) ||\n    !isFinite(distancia)\n) {\n    return null;\n}\n\nmsg.payload = {\n    temperatura,\n    umidade,\n    distancia\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
        "y": 240,
        "wires": [
